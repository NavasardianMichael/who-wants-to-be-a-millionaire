# =============================================================================
# systemd — API (Express). Install to /etc/systemd/system/millionaire-api.service
# Paths assume APP_DIR=/home/michael/apps/who-wants-to-be-a-millionaire.
#
# The env file is written by the deploy workflow (mode 600): ENV_API_BASE64 plus the four
# runtime keys it owns (NODE_ENV, PORT=9006, HOST=127.0.0.1, UPLOAD_DIR). systemd's
# EnvironmentFile is not dotenv — no `export`, no multi-line values.
# =============================================================================
[Unit]
Description=Millionaire — API (Express)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=michael
Group=michael
WorkingDirectory=/home/michael/apps/who-wants-to-be-a-millionaire/api/current
EnvironmentFile=/home/michael/apps/who-wants-to-be-a-millionaire/shared/.env.api
ExecStart=/usr/bin/node dist/src/index.js
Restart=always
RestartSec=2
KillSignal=SIGTERM
# The API drains in-flight requests for up to 25 s on SIGTERM (src/index.ts), inside this.
TimeoutStopSec=30
# The host runs several apps; this bounds the API so a login flood (argon2 holds 64 MiB per
# hash) or a leak cannot starve them. Past MemoryHigh the kernel reclaims and throttles; at
# MemoryMax it kills, and Restart=always brings it back. Check `systemctl status
# millionaire-api` before lowering either.
MemoryHigh=512M
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Avatars are the only thing the API writes to disk.
ReadWritePaths=/home/michael/apps/who-wants-to-be-a-millionaire/shared/uploads
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
