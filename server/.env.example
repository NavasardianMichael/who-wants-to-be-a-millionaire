# =============================================================================
# Millionaire API. One file per environment, both git-ignored:
#   server/.env.development.local   local dev — `pnpm dev`, `db:*`, Prisma (the default)
#   server/.env.production.local    production — part A only, encoded by `pnpm env:base64 production`
# The server loads server/.env.<NODE_ENV>.local, so NODE_ENV picks the file.
#   A. Secrets and per-environment URLs — production keeps these in a secret.
#   B. Runtime topology (bottom) — local dev only; the deploy sets these.
# =============================================================================

# --- A ----------------------------------------------------------------------

# Postgres from docker-compose.yml (host port 5006).
#   dev:   postgresql://millionaire:millionaire@localhost:5006/millionaire?schema=public
#   prod:  postgresql://millionaire:<hex-password>@127.0.0.1:5006/millionaire?schema=public
#          (127.0.0.1, never localhost; the first deploy creates the database with this password)
DATABASE_URL="postgresql://millionaire:millionaire@localhost:5006/millionaire?schema=public"

# Signs the session JWT and the Google OAuth flow cookie. Generate with
# `openssl rand -hex 64`. Rotating it signs everybody out.
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# The exact origin serving the web app, no trailing slash. requireSameOrigin
# compares against it; in production its hostname also becomes the session
# cookie's Domain (see src/lib/cookie-domain.ts).
# Production: https://who-wants-to-be-a-millionaire.eapps.site
CORS_ORIGIN="http://localhost:7006"
# COOKIE_DOMAIN=""   # only if the API is NOT a subdomain of the web host

# --- AI question writing --------------------------------------------------
# The provider is picked in code: one line in src/lib/ai/index.ts. Only the
# active provider's key matters; empty disables generation, and games are served
# from the question pool, then from the seeded English bank once that runs out.
#
# OpenRouter (free models only): a key from https://openrouter.ai/keys. Read only
# by src/lib/ai/openrouter.ts. Free models allow 20 requests a minute and 50 a
# day per account (1000 a day once the account has bought 10 credits, ever).
OPENROUTER_KEY=""
# Gemini: a billed key from https://aistudio.google.com/apikey. Read only by
# src/lib/ai/gemini.ts.
GEMINI_KEY=""
# "true" runs a second, blind answer-check pass on every generated batch and
# drops questions the checker disagrees with. Better accuracy, one extra call
# per batch (it only answers with option indexes).
VERIFY_QUESTIONS="false"
# Background top-up of the busiest (locale, level) buckets, ahead of demand.
# Off everywhere unless set to "true": the pools are seeded by hand, and AI
# writes only when a player has nothing unseen left (capped below).
# POOL_REFILL_ENABLED="true"
# POOL_REFILL_INTERVAL_MS="300000"
# POOL_REFILL_TARGET="60"
# POOL_REFILL_MAX_CALLS="4"
# The ceiling on AI batches started by player requests (a bucket with nothing
# unseen left): per hour for the whole server, and per player (account or IP).
# Past it, requests are served from what exists, so the bill has a known maximum.
# AI_LIVE_GENERATIONS_PER_HOUR="60"
# AI_LIVE_GENERATIONS_PER_PLAYER_PER_HOUR="10"
# Hourly, well-used ranked questions move to Classic (never the other way: a
# Classic question's answer is public). One moves after this many ranked serves,
# while its (language, level) reserve keeps at least RANKED_GRADUATION_KEEP.
# RANKED_GRADUATION_MIN_SERVES="20"
# RANKED_GRADUATION_KEEP="150"

# --- Google OAuth -----------------------------------------------------------
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI, character for character:
#   dev:   http://localhost:9006/identity/google/callback
#   prod:  https://api.who-wants-to-be-a-millionaire.eapps.site/identity/google/callback
# Leave both empty to run without Google: /health reports google:false and the
# web app hides the button. Email + password sign-in works either way.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9006/identity/google/callback"

# --- Mail engine (contact form, account emails) -----------------------------
# The engine bookie uses. Read only by src/lib/mail.ts. Empty key: the contact form
# and the verification / password-reset emails print to the console in dev (links
# included, so sign-up works locally), and answer 503 in production.
MAIL_API_URL="https://api-mail-engine.mnavasardian.com"
MAIL_API_KEY=""
MAIL_APP_ID="millionaire"

# --- B. LOCAL DEV ONLY --------------------------------------------------------
# Defaults to 9006.
# PORT=9006
# HOST=127.0.0.1
# Defaults to server/uploads.
# UPLOAD_DIR="./uploads"
# NODE_ENV is not set in these files: it is what picks the file (unset = development).
