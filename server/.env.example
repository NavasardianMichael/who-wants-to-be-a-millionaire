# =============================================================================
# Millionaire API. Copy to server/.env for local dev.
#   A. Secrets and per-environment URLs — production keeps these in a secret.
#   B. Runtime topology (bottom) — local dev only; the deploy sets these.
# =============================================================================

# --- A ----------------------------------------------------------------------

# Postgres from docker-compose.yml (host port 5006).
#   dev:   postgresql://millionaire:millionaire@localhost:5006/millionaire?schema=public
#   prod:  postgresql://millionaire:<hex-password>@127.0.0.1:5006/millionaire?schema=public
#          (127.0.0.1, never localhost; the password is POSTGRES_PASSWORD in $APP_DIR/db/.env)
DATABASE_URL="postgresql://millionaire:millionaire@localhost:5006/millionaire?schema=public"

# Signs the session JWT and the Google OAuth flow cookie. Generate with
# `openssl rand -hex 64`. Rotating it signs everybody out.
JWT_SECRET="change-me-in-production-use-a-long-random-string"

# The exact origin serving the web app, no trailing slash. requireSameOrigin
# compares against it; in production its hostname also becomes the session
# cookie's Domain (see src/lib/cookie-domain.ts).
# Production: https://who-wants-to-be-a-millionaire.mnavasardian.com
CORS_ORIGIN="http://localhost:7006"
# COOKIE_DOMAIN=""   # only if the API is NOT a subdomain of the web host

# --- Gemini ---------------------------------------------------------------
# A free key from https://aistudio.google.com/apikey. Read only by
# src/lib/gemini.ts. Empty disables generation: games are served from the
# question pool, and from the seeded English bank once that runs out.
GEMINI_KEY=""
# "true" runs a second, blind answer-check pass on every generated batch and
# drops questions the checker disagrees with. Better accuracy, ~2x quota.
VERIFY_QUESTIONS="false"
# Background top-up of the busiest (locale, level) buckets.
# POOL_REFILL_ENABLED="true"
# POOL_REFILL_INTERVAL_MS="300000"
# POOL_REFILL_TARGET="60"
# POOL_REFILL_MAX_CALLS="4"

# --- Google OAuth -----------------------------------------------------------
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI, character for character:
#   dev:   http://localhost:9006/identity/google/callback
#   prod:  https://api.who-wants-to-be-a-millionaire.mnavasardian.com/identity/google/callback
# Leave both empty to run without sign-in: /health reports google:false and the
# web app hides the button. Ranked modes need sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:9006/identity/google/callback"

# --- Mail engine (contact form) ---------------------------------------------
# The engine bookie uses. Read only by src/lib/mail.ts. Empty key: the contact form
# prints messages to the console in dev, and answers 503 in production.
MAIL_API_URL="https://api-mail-engine.mnavasardian.com"
MAIL_API_KEY=""
MAIL_APP_ID="millionaire"

# --- Sentry -----------------------------------------------------------------
# SENTRY_DSN_API=""

# --- B. LOCAL DEV ONLY --------------------------------------------------------
PORT=9006
# HOST=127.0.0.1
UPLOAD_DIR="./uploads"
NODE_ENV=development
